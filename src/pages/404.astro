---
import { getLocaleFromPath, getSiteConfig, getUi } from "@i18n";
import Layout from "@layouts/Layout.astro";
import "../styles/global.css";

const locale = getLocaleFromPath(Astro.url.pathname);
const config = {
  ...getSiteConfig(locale),
  title: getUi(locale).notFound.title,
  description: getUi(locale).notFound.description,
};
const ui = getUi(locale);
const homePath = locale === "fr" ? "/fr/" : "/";
---

<Layout locale={locale} config={config} ui={ui} noindex>
  <section class="py-32 text-center" aria-labelledby="not-found-title">
    <p class="mb-3 font-mono text-sm uppercase tracking-widest text-primary">404</p>
    <h1 id="not-found-title" class="mb-4 font-serif text-4xl font-bold text-white md:text-5xl">
      {ui.notFound.heading}
    </h1>
    <p class="mx-auto mb-10 max-w-md text-base text-neutral">{ui.notFound.description}</p>
    <nav class="flex flex-wrap items-center justify-center gap-3" aria-label="Recovery navigation">
      <a class="btn-primary rounded-full px-6 py-3 text-sm font-medium" href={homePath}>
        {ui.notFound.home}
      </a>
      <a
        class="rounded-full border border-border/40 px-6 py-3 text-sm text-white transition-colors hover:border-primary/60 hover:text-primary"
        href={`${homePath}#projects`}
      >
        {ui.notFound.projects}
      </a>
      <a
        class="rounded-full border border-border/40 px-6 py-3 text-sm text-white transition-colors hover:border-primary/60 hover:text-primary"
        href={`${homePath}#experience`}
      >
        {ui.notFound.experience}
      </a>
    </nav>
  </section>
</Layout>
