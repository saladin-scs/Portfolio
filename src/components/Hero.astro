---
import OptimizedImage from "./OptimizedImage.astro";
import type { HeroProps, UiStrings } from "@types";

type Props = HeroProps & { ui: UiStrings };

const { name, specialty, summary, email, socialLinks = [], ui } = Astro.props;

const iconMap: Record<string, string> = {
  LinkedIn: "/linkedin.svg",
  GitHub: "/github.svg",
  Portfolio: "/portfolio.svg",
  Resume: "/resume.svg",
  CV: "/resume.svg",
};

const contactLinks = [
  {
    label: "Email",
    href: `mailto:${email}`,
    description: email,
    external: false,
    icon: "mail" as const,
    download: false,
  },
  ...socialLinks.map(({ text, href }) => ({
    label: text,
    href,
    description:
      text === "Resume" || text === "CV"
        ? ui.hero.downloadCv
        : text === "GitHub"
          ? "github.com/saladin-scs"
          : text === "LinkedIn"
            ? "linkedin.com/in/saleheddinkhalfaoui"
            : text === "Portfolio"
              ? "saladinproduction.vercel.app"
              : text,
    external: !href.startsWith("/") && !href.startsWith("mailto:"),
    icon: (iconMap[text] ?? "link") as string,
    download: text === "Resume" || text === "CV",
  })),
];
---

<section class="py-24 md:py-32" id="hero" aria-labelledby="hero-title">
  <p class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl">
    {name}
  </p>
  <h1
    id="hero-title"
    class="mb-9 font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {ui.hero.professionalTitle}
  </h1>
  <p class="mb-4 text-lg font-medium text-white/85 md:text-xl">{specialty}</p>
  <p class="mb-10 text-base font-normal text-neutral md:mb-12 md:text-lg">
    {summary}
  </p>

  <div class="hero-contact theme-panel">
    <div class="hero-contact-header">
      <div>
        <p class="hero-contact-kicker">{ui.hero.getInTouch}</p>
        <h2 class="hero-contact-title">{ui.hero.contactTitle}</h2>
        <p class="hero-contact-subtitle">{ui.hero.contactSubtitle}</p>
      </div>
      <div class="hero-contact-primary-actions">
        <a class="btn-primary hero-contact-email-btn" href={`mailto:${email}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {ui.hero.emailMe}
        </a>
        <button
          type="button"
          class="hero-contact-copy"
          data-copy-email={email}
          data-copy-label={ui.hero.copyEmail}
          data-copied-label={ui.hero.copied}
          aria-label={ui.hero.copyEmail}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" stroke-linecap="round" />
          </svg>
          <span class="hero-contact-copy-text">{ui.hero.copyEmail}</span>
        </button>
      </div>
    </div>

    <ul class="hero-contact-grid list-none">
      {
        contactLinks.map(({ label, href, description, external, icon, download }) => (
          <li>
            <a
              href={href}
              class="hero-contact-card"
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
              download={download || undefined}
              aria-label={`${label}: ${description}`}
            >
              <span class="hero-contact-card-icon" aria-hidden="true">
                {
                  icon === "mail" ? (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  ) : typeof icon === "string" && icon.startsWith("/") ? (
                    <OptimizedImage src={icon} alt="" width={18} height={18} class="h-[18px] w-[18px]" />
                  ) : (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke-linecap="round" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke-linecap="round" />
                    </svg>
                  )
                }
              </span>
              <span class="hero-contact-card-body">
                <span class="hero-contact-card-label">{label}</span>
                <span class="hero-contact-card-value">{description}</span>
              </span>
              {
                external && (
                  <OptimizedImage
                    src="/external.svg"
                    alt=""
                    width={12}
                    height={12}
                    class="hero-contact-card-external"
                  />
                )
              }
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  function initCopyEmail() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((button) => {
      button.addEventListener("click", async () => {
        const email = button.dataset.copyEmail;
        const copyLabel = button.dataset.copyLabel ?? "Copy email";
        const copiedLabel = button.dataset.copiedLabel ?? "Copied!";
        const label = button.querySelector(".hero-contact-copy-text");

        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          if (label) label.textContent = copiedLabel;
          button.classList.add("is-copied");
          window.setTimeout(() => {
            if (label) label.textContent = copyLabel;
            button.classList.remove("is-copied");
          }, 2000);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    });
  }

  initCopyEmail();
  document.addEventListener("astro:page-load", initCopyEmail);
</script>

<style>
  .hero-contact {
    overflow: hidden;
    padding: 1.35rem;
  }

  @media (min-width: 768px) {
    .hero-contact {
      padding: 1.5rem 1.75rem;
    }
  }

  .hero-contact-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--theme-border) 55%, transparent);
  }

  @media (min-width: 768px) {
    .hero-contact-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .hero-contact-kicker {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-primary);
  }

  .hero-contact-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--theme-foreground);
  }

  .hero-contact-subtitle {
    margin: 0.5rem 0 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--theme-muted);
  }

  .hero-contact-primary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .hero-contact-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.85rem 1.35rem;
    font-size: 0.875rem;
    line-height: 1;
    text-decoration: none;
  }

  .hero-contact-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--theme-border) 70%, transparent);
    background: color-mix(in srgb, var(--theme-inset) 40%, transparent);
    padding: 0.85rem 1.15rem;
    font-size: 0.875rem;
    color: var(--theme-foreground);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .hero-contact-copy:hover {
    border-color: color-mix(in srgb, var(--theme-primary) 45%, var(--theme-border));
    color: var(--theme-primary);
  }

  .hero-contact-copy.is-copied {
    border-color: color-mix(in srgb, var(--theme-accent) 50%, var(--theme-border));
    color: var(--theme-accent);
  }

  .hero-contact-grid {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .hero-contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hero-contact-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-radius: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--theme-border) 60%, transparent);
    background: color-mix(in srgb, var(--theme-surface) 85%, transparent);
    padding: 0.9rem 1rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero-contact-card:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--theme-primary) 40%, var(--theme-border));
    box-shadow: var(--theme-shadow);
  }

  .hero-contact-card-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--theme-border) 55%, transparent);
    background: color-mix(in srgb, var(--theme-inset) 50%, transparent);
    color: var(--theme-primary);
  }

  .hero-contact-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .hero-contact-card-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--theme-foreground);
  }

  .hero-contact-card-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--theme-muted);
  }

  .hero-contact-card-external {
    flex-shrink: 0;
    opacity: 0.55;
  }

  .hero-contact-copy:focus-visible,
  .hero-contact-card:focus-visible {
    outline: 2px solid var(--theme-primary);
    outline-offset: 2px;
  }
</style>
