---
import Menu from "@icons/Menu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import OptimizedImage from "./OptimizedImage.astro";
import type { HeaderProps, Locale, UiStrings } from "@types";

type Props = HeaderProps & {
  locale: Locale;
  homePath: string;
  ui: UiStrings;
};

const { siteLogo, navLinks, locale, homePath, ui } = Astro.props;
---

<header
  class="site-header sticky top-0 z-50 mx-auto flex max-w-5xl animate-slide-in justify-between bg-header px-5 py-6 backdrop-blur-md"
>
  <a href={homePath} aria-label={ui.header.homeLink}>
    <OptimizedImage
      class="h-[45px] w-[45px] rounded-full object-cover ring-2 ring-border/30"
      src={siteLogo}
      width={45}
      height={45}
      alt={ui.header.logoAlt}
      priority
    />
  </a>

  <div class="flex items-center gap-2 sm:gap-3">
    <ThemeToggle ui={ui} />

    <nav
      class="hidden items-center gap-1 sm:flex"
      aria-label={ui.header.language}
    >
      <a
        href="/"
        class={`rounded-md px-2 py-1 text-xs font-medium transition-colors ${locale === "en" ? "text-white" : "text-neutral hover:text-white"}`}
        aria-label={ui.language.switchToEn}
        aria-current={locale === "en" ? "page" : undefined}
      >
        {ui.language.en}
      </a>
      <span class="text-neutral/40" aria-hidden="true">|</span>
      <a
        href="/fr/"
        class={`rounded-md px-2 py-1 text-xs font-medium transition-colors ${locale === "fr" ? "text-white" : "text-neutral hover:text-white"}`}
        aria-label={ui.language.switchToFr}
        aria-current={locale === "fr" ? "page" : undefined}
      >
        {ui.language.fr}
      </a>
    </nav>

    <button
      type="button"
      id="menu-button"
      class="px-1.5 text-neutral sm:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <Menu />
    </button>
  </div>

  <nav
    class="absolute top-20 right-5 hidden rounded-xl border border-border/40 bg-surface px-4 py-5 text-neutral shadow-lg sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
    id="main-menu"
  >
    <ul class="gap-2 sm:flex">
      {
        navLinks.map((link) => (
          <li class="relative">
            <a
              class="nav-item relative block p-2 text-sm font-medium transition-all duration-500 after:absolute after:bottom-0 after:left-2/4 after:h-2 after:w-1 after:-translate-x-2/4 after:text-primary after:opacity-0 after:content-['•'] hover:text-white"
              href={link.href}
            >
              {link.text}
            </a>
          </li>
        ))
      }
      <li class="mt-3 flex items-center justify-center gap-2 border-t border-border/20 pt-3 sm:mt-0 sm:hidden sm:border-0 sm:pt-0">
        <a
          href="/"
          class={`rounded-md px-2 py-1 text-xs font-medium ${locale === "en" ? "text-white" : "text-neutral hover:text-white"}`}
          aria-label={ui.language.switchToEn}
        >
          {ui.language.en}
        </a>
        <span class="text-neutral/40" aria-hidden="true">|</span>
        <a
          href="/fr/"
          class={`rounded-md px-2 py-1 text-xs font-medium ${locale === "fr" ? "text-white" : "text-neutral hover:text-white"}`}
          aria-label={ui.language.switchToFr}
        >
          {ui.language.fr}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll("#main-menu > ul > li > a.nav-item");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item?.addEventListener("click", toggleMenu);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("href") === `#${entry.target.id}`) {
              item.classList.add("text-white", "md:after:opacity-100");
            } else {
              item.classList.remove("text-white", "md:after:opacity-100");
            }
          });
        }
      });
    },
    { threshold: 0.5 },
  );

  document.querySelectorAll("section").forEach((section) => {
    observer.observe(section);
  });

  document.onvisibilitychange = () => {
    if (document.visibilityState === "hidden") {
      observer.disconnect();
    } else {
      document.querySelectorAll("section").forEach((section) => {
        observer.observe(section);
      });
    }
  };
</script>

<style>
  header {
    animation-timeline: scroll();
    animation-range: 0 650px;
  }
</style>
